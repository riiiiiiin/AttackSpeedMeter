UITips: {
	HeaderLabels: {
		MeleeSpeed: Melee Speed
		RangedSpeed: Ranged Speed
		MeleeNoSpeedSpeed: Melee (No Speed)
		MagicSpeed: Magic Speed
		SummonMeleeSpeedSpeed: Whip Speed
		ThrowingSpeed: Throwing Speed
		GenericSpeed: Generic Speed
		SummonSpeed: Summon Speed
	}

	# Only list those modded damage class names that
	#  can not be constructed from its original
	#  internal names in the corresponding language.
	# Do not copy the English version into other languages.
	# Each line is "FullName: Label", matched by the class's
	#  internal FullName (e.g. "CalamityMod/RogueDamageClass").
	ModdedHeaderLabels:
		'''
		CalamityMod/TrueMeleeNoSpeedDamageClass: True Melee (No Speed)
		ThoriumMod/HealerDamage: Healer Speed
		ThoriumMod/HealerTool: Healing Speed
		ThoriumMod/BardDamage: Bard Damage Speed
		'''
	HeaderFormat: "[LABEL]: [BUFF]"
	SuffixesToRemove: Damage, damage
	SuffixesToAdd: " Speed"

	UseTime: {
		SimpleStatusTemplate: Use time: [TIME]
		StatusTemplate: "[c/[COLORPREV]:[PREV] ←] [c/[COLORCURRENT]:Use Time: [TIME]] [c/[COLORNEXT]:→ [NEXT]]"
		ExtraMultiplierTemplate: Extra multiplier:player[PLAYER] item[ITEM]
	}

	UseAnimation: {
		StatusTemplate: "[c/[COLORPREV]:[PREV] ←] [c/[COLORCURRENT]:Animation: [TIME]] [c/[COLORNEXT]:→ [NEXT]]"
		ExtraMultiplierTemplate: Extra multiplier:player[PLAYER] item[ITEM]
	}

	Legend: {
		0: Legends TH. for threshold
		1: - Current Class: Attack Speed Buff -
		2: Prev. TH. ← Current use time → Next TH.
		3: Prev. TH. ← Current use animation → Next TH.
		4: Extra multiplier: player mult.  item mult.
		5: Info. above are shown only when necessary
		6: Hold a weapon to activate attack speed meter!
	}
}

"Keybinds.Toggle Attack Speed Meter.DisplayName": Toggle  Attack  Speed  Meter
OtherTips.OnEnterWorld: Bind a key to open/close attack speed meter!

Configs: {
	ASMConfigs: {
		DisplayName: Client Configs

		HPosition: {
			Label: Horizontal Position
			Tooltip: Determines the horizontal position of the UI on the screen
		}

		VPosition: {
			Label: Vertical Position
			Tooltip: Determines the vertical position of the UI on the screen
		}

		Width: {
			Label: UI Width
			Tooltip: The width of the UI
		}

		Draggable: {
			Label: Draggable
			Tooltip:
				'''
				Determines whether you can drag the panel
				Click and hold mouse left to drag
				'''
		}

		UseColor: {
			Label: Use Color
			Tooltip: ""
		}
	}
}
