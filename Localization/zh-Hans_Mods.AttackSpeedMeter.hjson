UITips: {
	HeaderLabels: {
		MeleeSpeed: 近战攻速
		RangedSpeed: 远程攻速
		MeleeNoSpeedSpeed: 非攻速近战攻速
		MagicSpeed: 魔法攻速
		SummonMeleeSpeedSpeed: 鞭子攻速
		ThrowingSpeed: 投掷攻速
		GenericSpeed: 全局攻速
		SummonSpeed: 召唤攻速
	}

	# Only list those modded damage class names that
	#  can not be constructed from its original
	#  internal names in the corresponding language.
	# Do not copy the English version into other languages.
	# Each line is "FullName: Label", matched by the class's
	#  internal FullName (e.g. "CalamityMod/RogueDamageClass").
	ModdedHeaderLabels:
		'''
		CalamityMod/TrueMeleeNoSpeedDamageClass: 非攻速真近战攻速
		CalamityMod/MeleeRangedHybridDamageClass: 近战-远程混合攻速
		CalamityMod/AverageDamageClass: 平均职业攻速
		ThoriumMod/HealerDamage: 光辉攻速
		ThoriumMod/HealerTool: 治疗速度
		ThoriumMod/BardDamage: 演奏速度
		'''
	HeaderFormat: "[LABEL]：[BUFF]"
	SuffixesToRemove: 伤害
	SuffixesToAdd: 攻速

	UseTime: {
		SimpleStatusTemplate: 当前使用时间: [TIME]
		StatusTemplate: "[c/[COLORPREV]:[PREV] ←] [c/[COLORCURRENT]:当前使用时间: [TIME]] [c/[COLORNEXT]:→ [NEXT]]"
		ExtraMultiplierTemplate: 额外倍率:玩家[PLAYER] 物品[ITEM]
	}

	UseAnimation: {
		StatusTemplate: "[c/[COLORPREV]:[PREV] ←] [c/[COLORCURRENT]:当前使用动画: [TIME]] [c/[COLORNEXT]:→ [NEXT]]"
		ExtraMultiplierTemplate: 额外倍率:玩家[PLAYER] 物品[ITEM]
	}

	Legend: {
		0: 图例
		1: - 当前职业:攻速数值 -
		2: 上一阈值 ← 当前使用时间 → 下一阈值
		3: 上一阈值 ← 当前使用动画 → 下一阈值
		4: 额外倍率:玩家倍率 物品倍率
		5: 只有当必要时才会显示上述信息
		6: 手持或使用武器来激活攻速表!
	}
}

"Keybinds.Toggle Attack Speed Meter.DisplayName": 开关攻速显示UI
OtherTips.OnEnterWorld: 为开关攻速表绑定一个按键！

Configs: {
	ASMConfigs: {
		DisplayName: 客户端配置

		HPosition: {
			Label: 水平位置
			Tooltip: 决定UI显示在屏幕上的水平位置
		}

		VPosition: {
			Label: 竖直位置
			Tooltip: 决定UI显示在屏幕上的竖直位置
		}

		Width: {
			Label: 宽度
			Tooltip: 攻速显示UI的宽度
		}

		Draggable: {
			Label: UI拖动
			Tooltip:
				'''
				决定是否允许拖动UI
				按住左键拖动
				'''
		}

		UseColor: {
			// Label: Use Color
			// Tooltip: ""
		}
	}
}
